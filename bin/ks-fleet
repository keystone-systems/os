# ks-fleet — deploy and test a mixed fleet of VMs and baremetal machines
# from one script, driven entirely by the flake's `fleetMeta` output
# (produced by lib/mk-fleet.nix). No host knowledge lives here.
#
# Realizations: a host runs as a local QEMU VM (`vm`) or as a physical
# machine reached over ssh (`machine`). Each host's default realization
# comes from fleetMeta; `--as` forces one for the named hosts, so the same
# fleet definition tests as all-VMs, all-metal, or any mix.

usage() {
  cat <<'EOF'
usage: ks-fleet <command> [host ...] [flags]

commands:
  status            show each host's realization, endpoint, and reachability
  up                boot the vm-realized hosts (background, state in .fleet/)
  down              stop vm-realized hosts
  deploy            vm: rebuild + restart; machine: nixos-rebuild to target
  test              deploy/boot every host, wait for ssh, run smoke checks
  install           DESTRUCTIVE. Reinstall a machine from scratch with
                    nixos-anywhere: disko repartitions the target disk and
                    every byte on it is lost. Only hosts marked
                    `install.erasable` in fleetMeta are eligible, and
                    --erase-confirm <host> is required. The LUKS passphrase
                    is written to a file and handed to disko, never typed.
                    This is the metal twin of the disko VM check, so the same
                    disk-config is proven in both places.

flags:
  --as vm|machine   force a realization for the named hosts
  --erase-confirm H retype the hostname to authorize `install` erasing it
  --dry-run         install: run every guard, verify the target's identity,
                    print the exact nixos-anywhere command and the seed plan,
                    and stop before touching the disk or cloning anything.
                    Safe to run against a live machine.
  --verify-addr A   install: check the installed host at this address instead
                    of the fleetMeta target. A reinstall can come up on a
                    different lease than the one pinned (e.g. pinned on wi-fi,
                    installed over ethernet). Also settable per host as
                    fleetMeta `install.verifyTarget`.
  --durable         machine deploys use `switch` instead of `test`
  --no-deploy       test: smoke only, skip deploy/boot
  --allow-degraded  smoke passes on systemd state 'degraded' (e.g. vm boots
                    of hosts whose host-bound secrets cannot decrypt)
  --flake REF       fleet flake (default: ., or $KS_FLEET_FLAKE)
  --timeout SECS    ssh wait timeout per host (default: 180)
  --vm-host U@H     delegate vm realizations to a remote machine (e.g.
                    ncrmro@ocean): the runner closure is nix-copied there,
                    QEMU runs remotely, and smoke ssh goes through it as a
                    jump host. Requires KVM and the 9p-shared checkouts on
                    the remote. Also via $KS_FLEET_VM_HOST.

environment:
  KS_FLEET_DIR      vm state/log directory (default: $PWD/.fleet; remote
                    vms use /tmp/ksf on the vm host)
  KS_FLEET_VM_USER  ssh user for vm smoke checks (default: root)
  KS_FLEET_VM_HOST  default --vm-host
  KS_INSTALL_PASSPHRASE
                    LUKS passphrase written for disko during `install`.
                    Defaults to the fleetMeta `install.passphrase` value, so
                    a test host can carry its own known credential.

With no hosts named, a command applies to the whole fleet — which is how a
mixed fleet (e.g. ks-test-delltop on real hardware, the rest as VMs) is
deployed and smoke-tested in one run: `ks-fleet test`.
EOF
}

die() {
  echo "ks-fleet: $*" >&2
  exit 1
}

FLAKE="${KS_FLEET_FLAKE:-.}"
STATE_DIR="${KS_FLEET_DIR:-$PWD/.fleet}"
VM_USER="${KS_FLEET_VM_USER:-root}"
VM_HOST="${KS_FLEET_VM_HOST:-}"
FORCE_AS=""
DEPLOY_MODE="test"
NO_DEPLOY=0
ALLOW_DEGRADED=0
TIMEOUT=180
TIMEOUT_SET=0
ERASE_CONFIRM=""
VERIFY_ADDR=""
DRY_RUN=0

CMD="${1:-}"
[[ -n $CMD ]] || {
  usage
  exit 1
}
shift
case "$CMD" in
-h | --help | help)
  usage
  exit 0
  ;;
status | up | down | deploy | test | install) ;;
*) die "unknown command: $CMD" ;;
esac

HOSTS=()
while (($#)); do
  case "$1" in
  --as)
    FORCE_AS="${2:-}"
    [[ $FORCE_AS == vm || $FORCE_AS == machine ]] || die "--as takes vm|machine"
    shift 2
    ;;
  --durable)
    DEPLOY_MODE="switch"
    shift
    ;;
  --no-deploy)
    NO_DEPLOY=1
    shift
    ;;
  --allow-degraded)
    ALLOW_DEGRADED=1
    shift
    ;;
  --erase-confirm)
    ERASE_CONFIRM="${2:?}"
    shift 2
    ;;
  --dry-run)
    DRY_RUN=1
    shift
    ;;
  --vm-host)
    VM_HOST="${2:?}"
    shift 2
    ;;
  --flake)
    FLAKE="${2:?}"
    shift 2
    ;;
  --timeout)
    TIMEOUT="${2:?}"
    TIMEOUT_SET=1
    shift 2
    ;;
  --verify-addr)
    VERIFY_ADDR="${2:?}"
    shift 2
    ;;
  -*) die "unknown flag: $1" ;;
  *)
    HOSTS+=("$1")
    shift
    ;;
  esac
done

META="$(nix eval --json "$FLAKE#fleetMeta")" || die "cannot eval $FLAKE#fleetMeta"
mapfile -t ALL_HOSTS < <(jq -r '.hosts | keys[]' <<<"$META")
((${#HOSTS[@]})) || HOSTS=("${ALL_HOSTS[@]}")

host_json() {
  local j
  j="$(jq -c --arg h "$1" '.hosts[$h] // empty' <<<"$META")"
  [[ -n $j ]] || die "unknown host: $1 (fleet: ${ALL_HOSTS[*]})"
  echo "$j"
}

realization() {
  local h="$1" j r
  j="$(host_json "$h")"
  r="${FORCE_AS:-$(jq -r .default <<<"$j")}"
  [[ "$(jq -r ".$r" <<<"$j")" != null ]] || die "$h has no $r realization"
  echo "$r"
}

vm_port() { jq -r .vm.sshPort <<<"$(host_json "$1")"; }
vm_vnc() { jq -r .vm.vncPort <<<"$(host_json "$1")"; }
machine_addr() { jq -r '"\(.machine.user)@\(.machine.sshTarget)"' <<<"$(host_json "$1")"; }

REMOTE_DIR=/tmp/ksf

vm_pid() {
  local h="$1" f pid
  if [[ -n $VM_HOST ]]; then
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$VM_HOST" \
      "pid=\$(cat $REMOTE_DIR/$h.pid 2>/dev/null) && kill -0 \"\$pid\" 2>/dev/null && echo \"\$pid\"" 2>/dev/null
    return
  fi
  f="$STATE_DIR/$h.pid"
  [[ -f $f ]] || return 1
  pid="$(cat "$f")"
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

vm_up() {
  local h="$1" out port extra_env=0
  port="$(vm_port "$h")"
  if vm_pid "$h" >/dev/null; then
    echo "$h: vm already running (ssh -p $port localhost)"
    return 0
  fi
  echo "$h: building vm..."
  # Prefer the harness's vm-<host> package (mkFleet: port/VNC baked in);
  # fall back to the host's plain system.build.vm for consumer flakes that
  # have not adopted mkFleet, adding ssh forwarding via QEMU_NET_OPTS.
  if out="$(nix build --no-link --print-out-paths "$FLAKE#vm-$h" 2>/dev/null)"; then
    :
  else
    out="$(nix build --no-link --print-out-paths       "$FLAKE#nixosConfigurations.$h.config.system.build.vm")"
    extra_env=1
  fi
  if [[ -n $VM_HOST ]]; then
    echo "$h: copying vm closure to $VM_HOST..."
    nix copy --to "ssh://$VM_HOST" "$out"
    ssh -o BatchMode=yes "$VM_HOST" \
      "mkdir -p $REMOTE_DIR && cd $REMOTE_DIR && QEMU_NET_OPTS='hostfwd=tcp::$port-:22' QEMU_OPTS='-display none' nohup '$out/bin/run-$h-vm' >'$h.log' 2>&1 & echo \$! >$REMOTE_DIR/$h.pid"
    echo "$h: vm started on $VM_HOST (ssh -J $VM_HOST -p $port localhost | log $VM_HOST:$REMOTE_DIR/$h.log)"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  (
    cd "$STATE_DIR"
    if ((extra_env)); then
      export QEMU_NET_OPTS="hostfwd=tcp::$port-:22"
      export QEMU_OPTS="${QEMU_OPTS:--display none}"
    fi
    nohup "$out/bin/run-$h-vm" >"$h.log" 2>&1 &
    echo $! >"$h.pid"
  )
  echo "$h: vm started (ssh -p $port localhost | log $STATE_DIR/$h.log)"
}

vm_down() {
  local h="$1" pid
  if [[ -n $VM_HOST ]]; then
    ssh -o BatchMode=yes "$VM_HOST" \
      "pid=\$(cat $REMOTE_DIR/$h.pid 2>/dev/null) && kill \"\$pid\" 2>/dev/null; rm -f $REMOTE_DIR/$h.pid" 2>/dev/null || true
    echo "$h: vm stopped on $VM_HOST"
    return 0
  fi
  if pid="$(vm_pid "$h")"; then
    kill "$pid" 2>/dev/null || true
    echo "$h: vm stopped"
  fi
  rm -f "$STATE_DIR/$h.pid"
}

machine_deploy() {
  local h="$1" j addr args
  j="$(host_json "$h")"
  addr="$(machine_addr "$h")"
  args=("$DEPLOY_MODE" --flake "$FLAKE#$h" --target-host "$addr")
  [[ "$(jq -r .machine.user <<<"$j")" != root ]] && args+=(--use-remote-sudo)
  [[ "$(jq -r .machine.buildOnRemote <<<"$j")" == true ]] && args+=(--build-host "$addr")
  echo "$h: nixos-rebuild ${args[*]}"
  nixos-rebuild "${args[@]}"
}

# Confirm the box answering on that address is the box we think it is, by
# comparing its live host key against the one pinned in fleetMeta. An IP can
# change under you -- a pinned key cannot -- so this, not the address, is what
# makes an erase safe to authorize.
verify_host_key() {
  local h="$1" target="$2" pinned="$3" type live want
  [[ -n $pinned && $pinned != null ]] ||
    die "$h has no machine.hostPublicKey pinned; refusing to erase an unverified target"
  type="${pinned%% *}"
  want="${pinned#* }"
  want="${want%% *}"
  # ssh-keyscan prefixes banner lines with '#', and those carry three fields
  # too, so select on the key type rather than on field count.
  # `|| true`: under errexit+pipefail an unreachable target makes this
  # assignment fail, which aborts the script with no message at all. The
  # explicit check below is the intended, legible failure.
  live="$(ssh-keyscan -T 10 -t "$type" "$target" 2>/dev/null |
    awk -v t="$type" '$1 !~ /^#/ && $2 == t { print $3; exit }')" || true
  [[ -n $live ]] || die "$h: no $type host key from $target (is it powered on?)"
  [[ $live == "$want" ]] ||
    die "$h: host key at $target does not match fleetMeta. Refusing to erase.
  pinned: $want
  live:   $live"
  echo "$h: host key verified against fleetMeta ($target)"
}

# nixos-anywhere authenticates as root and retries hard when it cannot. On a
# host whose root accepts only sk-* hardware credentials, an unattached
# authenticator turns into a burst of failed auth, which trips sshd's throttle,
# which then surfaces as `Connection reset by peer` -- a network-shaped symptom
# for a credential-shaped cause. One probe up front converts that into a
# two-second, legible failure, and lets --dry-run catch it before an erase.
#
# The probe also opens a shared control socket. Where root is hardware-only,
# every new ssh connection costs a separate touch, and nixos-anywhere makes
# several before it kexecs -- so an unattended install is impossible and an
# attended one is a sequence of blind touches. One master connection, reused
# by the probe and by nixos-anywhere, turns that into a single touch. The
# socket dies at kexec by design; the installer is a different machine.
INSTALL_SSH_CONTROL=""

preflight_root_ssh() {
  local h="$1" addr="$2"
  INSTALL_SSH_CONTROL="${TMPDIR:-/tmp}/ks-fleet-install-$h.sock"
  # A live socket from a previous invocation is the point: it lets `--dry-run`
  # and the real run share one authentication. Only clear a dead one -- an
  # unconditional rm would throw away the touch the operator just spent.
  if [[ -S $INSTALL_SSH_CONTROL ]]; then
    if ssh -o ControlPath="$INSTALL_SSH_CONTROL" -O check "$addr" 2>/dev/null; then
      echo "$h: root ssh reusing the open connection (no new touch needed)"
      return 0
    fi
    rm -f "$INSTALL_SSH_CONTROL"
  fi
  ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ControlMaster=auto -o ControlPath="$INSTALL_SSH_CONTROL" \
    -o ControlPersist=15m "$addr" true 2>/dev/null && {
    echo "$h: root ssh authenticated (connection shared; one touch covers the run)"
    return 0
  }
  {
    echo "ks-fleet: $h: cannot authenticate to $addr"
    echo "  nixos-anywhere installs as root, so this must work before an erase."
    if ssh-add -L 2>/dev/null | grep -q '^sk-'; then
      echo "  an sk-* credential is in the agent -- is the authenticator attached?"
    else
      echo "  no sk-* credential is loaded in the ssh agent."
      echo "  if root here is hardware-only, attach the security key and retry."
    fi
    echo "  a stale known_hosts entry for this address will also refuse; the"
    echo "  install itself bypasses known_hosts, but your own ssh will not."
  } >&2
  return 1
}

# The kexec installer is a different machine on the same hardware: it
# re-applies the addresses and routes it snapshotted from the running system,
# but it carries no NetworkManager, no wpa_supplicant and no wireless
# firmware. A host reached over wi-fi therefore goes silent the moment kexec
# fires, with the disk still untouched and no way back except a power cycle.
# That is what happened to ks-test-delltop on 2026-08-02. Kexec is the point
# of no return for reachability, so this check runs before it, not after.
preflight_wired_route() {
  local h="$1" addr="$2" iface

  iface="$(install_ssh "$addr" \
    "ip -o route get 1.1.1.1 2>/dev/null | grep -o 'dev [^ ]*' | head -1 | cut -d' ' -f2")" || {
    echo "$h: WARNING cannot read the target's default route; wireless check skipped" >&2
    return 0
  }
  [[ -n $iface ]] || {
    echo "$h: WARNING target reports no default route; wireless check skipped" >&2
    return 0
  }

  if [[ "$(install_ssh "$addr" "test -d /sys/class/net/$iface/wireless && echo wireless || echo wired")" == wireless ]]; then
    {
      echo "ks-fleet: $h: reached over the wireless interface '$iface'"
      echo "  the nixos-anywhere kexec installer has no wireless support, so the"
      echo "  host goes unreachable at kexec and the install cannot finish."
      echo "  connect $h to wired ethernet and rerun. to override, set"
      echo "  KS_INSTALL_ALLOW_WIRELESS=1 -- expect to power-cycle the machine."
    } >&2
    [[ ${KS_INSTALL_ALLOW_WIRELESS:-0} == 1 ]] || return 1
    echo "$h: WARNING continuing over wireless because KS_INSTALL_ALLOW_WIRELESS=1" >&2
    return 0
  fi
  echo "$h: reached over wired interface '$iface'; kexec can keep the network"
}

# Run a command on the install target, reusing the preflight's control socket.
install_ssh() {
  local addr="$1" cmd="$2" opts=(-o BatchMode=yes -o ConnectTimeout=10
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
  [[ -n $INSTALL_SSH_CONTROL ]] &&
    opts+=(-o ControlMaster=auto -o ControlPath="$INSTALL_SSH_CONTROL")
  # $cmd is built here on purpose: the caller interpolates local values (the
  # interface name) that the target cannot know.
  # shellcheck disable=SC2029
  ssh "${opts[@]}" "$addr" "$cmd" 2>/dev/null
}

# nixos-anywhere gained --target-host and deprecated the positional form.
# Support both so this works across the versions in circulation.
nixos_anywhere_target_args() {
  if nixos-anywhere --help 2>&1 | grep -q -- '--target-host'; then
    printf '%s\n%s\n' --target-host "$1"
  else
    printf '%s\n' "$1"
  fi
}

# The first home-manager activation hard-requires an editable checkout that a
# fresh install cannot have: `stowDotfiles` exits 1 when the dotfiles repo is
# absent, and because it runs before the write boundary that aborts the whole
# activation -- the user lands with no shell, editor or compositor config.
# Nothing in the OS provisions it (`keystone.repos` is a URL registry, not a
# provisioner), so seed it here from the machine driving the install, which by
# definition already has the repo. A declared remote is the fallback. That
# remote is whatever fleetMeta names -- a forge is never assumed, because a
# fleet's config may live on its own Forgejo rather than a public host.
INSTALL_TMP=""
SEED_DIR=""

install_cleanup() {
  [[ -n $INSTALL_TMP ]] && rm -rf "$INSTALL_TMP"
  [[ -n $SEED_DIR ]] && rm -rf "$SEED_DIR"
  return 0
}

install_stage_seed() {
  local h="$1" seed count i path src remote ref
  seed="$(jq -c '.install.seed // empty' <<<"$(host_json "$h")")"
  [[ -n $seed && $seed != null ]] || return 0
  count="$(jq '.repos // [] | length' <<<"$seed")"
  ((count > 0)) || return 0

  ((DRY_RUN)) || SEED_DIR="$(mktemp -d)"
  for ((i = 0; i < count; i++)); do
    path="$(jq -r ".repos[$i].path" <<<"$seed")"
    src="$(jq -r ".repos[$i].localSource // empty" <<<"$seed")"
    remote="$(jq -r ".repos[$i].remote // empty" <<<"$seed")"
    ref="$(jq -r ".repos[$i].ref // \"main\"" <<<"$seed")"

    if [[ -n $src ]] && git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
      echo "$h: seed /$path <- $src (this machine)"
      ((DRY_RUN)) && continue
      mkdir -p "$SEED_DIR/$(dirname "$path")"
      # Clone rather than copy: committed state and local branches travel, but
      # uncommitted edits and untracked files never get seeded onto a host.
      git clone --quiet --no-hardlinks --branch "$ref" "$src" "$SEED_DIR/$path" ||
        die "$h: cannot clone $src"
    else
      [[ -n $remote ]] ||
        die "$h: seed /$path has no usable localSource and no remote"
      echo "$h: seed /$path <- $remote (no local checkout)"
      ((DRY_RUN)) && continue
      mkdir -p "$SEED_DIR/$(dirname "$path")"
      git clone --quiet --branch "$ref" "$remote" "$SEED_DIR/$path" ||
        die "$h: cannot clone $remote"
    fi
    # Whichever source was used, the checkout must point at the canonical
    # remote, or the first fetch on the new host goes nowhere useful.
    [[ -n $remote ]] &&
      git -C "$SEED_DIR/$path" remote set-url origin "$remote"
  done

  # tar extracts with --no-same-owner, so everything lands root-owned. Chown
  # the whole user tree, not just the repo: a root-owned ~/repos breaks
  # keystoneEnsurePaths exactly as the 9p share does in the vm variant.
  ((DRY_RUN)) && return 0
  [[ -d $SEED_DIR/home ]] && chmod 755 "$SEED_DIR/home"
  return 0
}

# Assert the seeded checkouts actually arrived and are usable by their owner.
# `smoke` is the functional proof -- a failed seed fails home-manager, which
# makes the system degraded -- but this says which checkout and why.
install_verify_seed() {
  local h="$1" seed count i path uid
  seed="$(jq -c '.install.seed // empty' <<<"$(host_json "$h")")"
  [[ -n $seed && $seed != null ]] || return 0
  count="$(jq '.repos // [] | length' <<<"$seed")"
  for ((i = 0; i < count; i++)); do
    path="$(jq -r ".repos[$i].path" <<<"$seed")"
    # shellcheck disable=SC2029 # $path is a local value the target cannot know
    "${SSH_CMD[@]}" "test -d '/$path/.git'" 2>/dev/null || {
      echo "$h: seeded checkout /$path is missing" >&2
      return 1
    }
    # shellcheck disable=SC2029
    uid="$("${SSH_CMD[@]}" "stat -c %u '/$path'" 2>/dev/null)" || true
    [[ -n $uid && $uid != 0 ]] || {
      echo "$h: /$path is still root-owned; the --chown did not apply" >&2
      return 1
    }
    echo "$h: seeded /$path present, owned by uid $uid"
  done
}

# A fresh install often answers on a different address than fleetMeta pins:
# the pinned target may be the wi-fi lease, while the install runs over
# ethernet and the installed system keeps the wired lease. Verifying the wrong
# address makes a good install look like a failed one.
install_verify_addr() {
  local h="$1" j addr user
  j="$(host_json "$h")"
  addr="${VERIFY_ADDR:-$(jq -r '.install.verifyTarget // empty' <<<"$j")}"
  [[ -n $addr && $addr != null ]] || return 0
  user="$(jq -r '.machine.user // "root"' <<<"$j")"
  SSH_CMD=(ssh -o BatchMode=yes -o ConnectTimeout=5 "$user@$addr")
  echo "$h: verifying at $user@$addr"
}

# DESTROYS the target disk. See the `install` entry in usage().
machine_install() {
  local h="$1" j io addr target pinned passphrase keypath disk tmp
  j="$(host_json "$h")"
  io="$(jq -c '.install // empty' <<<"$j")"
  [[ -n $io && $io != null ]] || die "$h has no install realization in fleetMeta"
  [[ "$(jq -r '.erasable // false' <<<"$io")" == true ]] ||
    die "$h is not marked install.erasable in fleetMeta; refusing to reinstall"
  [[ $ERASE_CONFIRM == "$h" ]] ||
    die "refusing to erase $h without: --erase-confirm $h"

  target="$(jq -r .machine.sshTarget <<<"$j")"
  pinned="$(jq -r '.machine.hostPublicKey // empty' <<<"$j")"
  keypath="$(jq -r '.diskEncryptionKeyPath // empty' <<<"$io")"
  disk="$(jq -r '.targetDisk // empty' <<<"$io")"
  passphrase="${KS_INSTALL_PASSPHRASE:-$(jq -r '.passphrase // empty' <<<"$io")}"
  [[ -n $keypath ]] ||
    die "$h: install.diskEncryptionKeyPath unset; disko needs a passphrase file path"
  [[ -n $passphrase ]] ||
    die "$h: no passphrase (set KS_INSTALL_PASSPHRASE or install.passphrase)"

  verify_host_key "$h" "$target" "$pinned"
  addr="root@$target"
  preflight_root_ssh "$h" "$addr" || die "$h: root ssh preflight failed; not erasing"
  preflight_wired_route "$h" "$addr" || die "$h: wireless route; not erasing"

  # Stage before the erase: a seed that cannot be resolved should stop the run
  # while the disk is still intact, not after it has been repartitioned.
  trap install_cleanup EXIT
  install_stage_seed "$h"

  if ((DRY_RUN)); then
    echo "$h: DRY RUN -- nothing will be written"
    echo "  target:     $addr"
    echo "  disk:       $disk  (WOULD BE ERASED)"
    echo "  passphrase: handed to disko at $keypath (${#passphrase} chars, not shown)"
    echo "  command:    nixos-anywhere --copy-host-keys --flake $FLAKE#$h \\"
    echo "                --disk-encryption-keys $keypath <tmpfile> \\"
    echo "                $addr    (host keys carried across)"
    echo "$h: rerun without --dry-run to erase and reinstall"
    return 0
  fi

  echo "$h: ERASING $disk on $target -- every byte on that disk is lost."

  # Keep secrets and the captured host identity off disk-backed storage.
  tmp="$(mktemp -d /dev/shm/ks-fleet.XXXXXX 2>/dev/null || mktemp -d)"
  chmod 700 "$tmp"
  INSTALL_TMP="$tmp"
  printf '%s' "$passphrase" >"$tmp/secret.key"
  chmod 600 "$tmp/secret.key"

  # verify_host_key already authenticated this machine against fleetMeta, and
  # the host key legitimately changes twice from here -- once when kexec boots
  # the installer with its own ephemeral key, once when the installed system
  # comes up. So the install's own ssh cannot pin a single key, and a stale
  # entry in the operator's known_hosts (delltop's address had one, left by
  # whatever held it previously) would abort the run outright. Identity is
  # established before this point, not during it.
  # fleetMeta pins this host's public key and sops recipients derive from it,
  # so a reinstall that mints a fresh identity invalidates both.
  # --copy-host-keys makes nixos-anywhere carry the existing keys across
  # itself, which is one fewer root ssh round-trip than fetching them here --
  # and on a host whose root only accepts hardware credentials, one fewer
  # round-trip is one fewer touch.
  # By default nixos-anywhere lets the target substitute, so the installer
  # pulls most of the closure from cache.nixos.org over the WAN -- measured at
  # 2848 destination fetches against 232 pushed paths on ks-test-delltop. The
  # fleet is on one LAN and the operator's machine already holds the closure it
  # just built, so pushing beats downloading. This also implies
  # --no-use-machine-substituters, which stops the installer inheriting
  # cache.ncrmro.com: that name only resolves on the tailnet, so in the
  # installer it is pure retry latency.
  # Compression is off for the same reason -- at LAN speed it costs CPU on both
  # ends and buys nothing.
  local args=(
    --ssh-option StrictHostKeyChecking=no
    --ssh-option UserKnownHostsFile=/dev/null
    --ssh-option Compression=no
    --no-substitute-on-destination
    --ssh-store-setting compress false
    --copy-host-keys
    --flake "$FLAKE#$h" --disk-encryption-keys "$keypath" "$tmp/secret.key"
  )
  # Reuse the master opened by the preflight, so the pre-kexec phase costs
  # the one touch already spent rather than one per connection.
  [[ -n $INSTALL_SSH_CONTROL ]] && args+=(
    --ssh-option ControlMaster=auto
    --ssh-option ControlPath="$INSTALL_SSH_CONTROL"
    --ssh-option ControlPersist=15m
  )
  # Extra files land in the new root before nixos-install runs, so the very
  # first home-manager activation already has the checkouts it requires.
  if [[ -n $SEED_DIR ]]; then
    args+=(--extra-files "$SEED_DIR")
    while read -r cpath cowner; do
      [[ -n $cpath ]] && args+=(--chown "$cpath" "$cowner")
    done < <(jq -r '.install.seed.chown // {} | to_entries[] | "\(.key) \(.value)"' \
      <<<"$(host_json "$h")")
  fi
  mapfile -t target_args < <(nixos_anywhere_target_args "$addr")
  args+=("${target_args[@]}")

  echo "$h: nixos-anywhere --flake $FLAKE#$h ... $addr"
  nixos-anywhere "${args[@]}" || die "$h: nixos-anywhere failed"
  echo "$h: install finished; waiting for ssh"
}

# The invariant that stopped ncrmro-workstation booting generations 637-641:
# the initrd must never ask for a credential the LUKS header does not hold.
# Checked here because a fresh install is exactly when the two can diverge.
install_verify_credentials() {
  local h="$1" targets opts name dump
  targets="$(nix eval --json "$FLAKE#nixosConfigurations.$h.config.keystone.hardwareKeyLuksTargets" 2>/dev/null)" || return 0
  for name in $(jq -r '.[]' <<<"$targets" 2>/dev/null); do
    opts="$(nix eval --json "$FLAKE#nixosConfigurations.$h.config.boot.initrd.luks.devices.\"$name\".crypttabExtraOpts" 2>/dev/null)" || continue
    grep -q 'fido2-device=auto' <<<"$opts" || {
      echo "$h: $name requests no FIDO2 credential -- passphrase path retained"
      continue
    }
    dump="$("${SSH_CMD[@]}" "sudo -n cryptsetup luksDump /dev/disk/by-partlabel/disk-*-$name 2>/dev/null" 2>/dev/null)" || true
    if [[ -z $dump ]]; then
      echo "$h: WARNING cannot read the $name LUKS header; FIDO2 request unverified" >&2
      continue
    fi
    if grep -q 'systemd-fido2' <<<"$dump"; then
      echo "$h: $name requests FIDO2 and the header holds a systemd-fido2 token"
    else
      echo "$h: FAIL $name initrd requests fido2-device=auto but no token is enrolled." >&2
      echo "$h: systemd does not fall back to the passphrase here (systemd#19872)." >&2
      return 1
    fi
  done
}

# Sets SSH_CMD for host+realization. VM host keys are ephemeral (fresh
# install every boot), so verification is disabled for them only; machines
# keep normal known_hosts pinning.
ssh_for() {
  local h="$1" r="$2"
  if [[ $r == vm ]]; then
    SSH_CMD=(ssh -p "$(vm_port "$h")" -o UserKnownHostsFile=/dev/null
      -o StrictHostKeyChecking=no -o LogLevel=ERROR -o BatchMode=yes
      -o ConnectTimeout=5 "$VM_USER@localhost")
    [[ -n $VM_HOST ]] && SSH_CMD+=(-o "ProxyJump=$VM_HOST")
  else
    SSH_CMD=(ssh -o BatchMode=yes -o ConnectTimeout=5 "$(machine_addr "$h")")
  fi
}

wait_ssh() {
  local deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    "${SSH_CMD[@]}" true 2>/dev/null && return 0
    sleep 3
  done
  return 1
}

# A fresh install has no remote unlock, so the host sits at a passphrase prompt
# and stays unreachable until a person answers it at the console. That has no
# bounded duration: a 900s cap expired before the operator reached the machine,
# which turned a good install into a reported failure and left the post-install
# checks un-run. Wait indefinitely by default and say why every minute; an
# explicit --timeout still bounds it, which is what CI wants.
wait_ssh_unlock() {
  local h="$1" waited=0
  if ((TIMEOUT_SET)); then
    wait_ssh
    return
  fi
  while ! "${SSH_CMD[@]}" true 2>/dev/null; do
    ((waited % 60 == 0)) &&
      echo "$h: waiting for the LUKS passphrase at its console (${waited}s; --timeout bounds this)"
    sleep 5
    waited=$((waited + 5))
  done
  return 0
}

smoke() {
  local h="$1" state
  state="$("${SSH_CMD[@]}" systemctl is-system-running --wait 2>/dev/null)" || true
  if [[ $state == running ]]; then
    return 0
  fi
  if [[ $state == degraded ]] && ((ALLOW_DEGRADED)); then
    echo "$h: degraded accepted (--allow-degraded); failed units:" >&2
    "${SSH_CMD[@]}" systemctl --failed --no-legend 2>/dev/null >&2 || true
    return 0
  fi
  echo "$h: system state '$state'; failed units:" >&2
  "${SSH_CMD[@]}" systemctl --failed --no-legend 2>/dev/null >&2 || true
  return 1
}

RESULTS=()
FAILED=0

run_test() {
  local h="$1" r
  r="$(realization "$h")"
  if [[ $r == vm ]]; then
    vm_up "$h"
  elif ((!NO_DEPLOY)); then
    machine_deploy "$h" || {
      RESULTS+=("$h $r deploy-failed")
      FAILED=1
      return
    }
  fi
  ssh_for "$h" "$r"
  if ! wait_ssh; then
    RESULTS+=("$h $r unreachable")
    FAILED=1
    return
  fi
  if smoke "$h"; then
    RESULTS+=("$h $r ok")
  else
    RESULTS+=("$h $r degraded")
    FAILED=1
  fi
}

case "$CMD" in
status)
  printf '%-24s %-8s %-28s %s\n' HOST REALIZED ENDPOINT STATE
  for h in "${HOSTS[@]}"; do
    r="$(realization "$h")"
    if [[ $r == vm ]]; then
      ep="localhost:$(vm_port "$h")"
      if vm_pid "$h" >/dev/null; then st=running; else st=stopped; fi
    else
      ep="$(machine_addr "$h")"
      ssh_for "$h" "$r"
      if "${SSH_CMD[@]}" true 2>/dev/null; then st=reachable; else st=unreachable; fi
    fi
    printf '%-24s %-8s %-28s %s\n' "$h" "$r" "$ep" "$st"
  done
  ;;
up)
  for h in "${HOSTS[@]}"; do
    [[ "$(realization "$h")" == vm ]] && vm_up "$h"
  done
  ;;
down)
  for h in "${HOSTS[@]}"; do
    [[ "$(realization "$h")" == vm ]] && vm_down "$h"
  done
  ;;
deploy)
  for h in "${HOSTS[@]}"; do
    if [[ "$(realization "$h")" == vm ]]; then
      vm_down "$h"
      vm_up "$h"
    else
      machine_deploy "$h"
    fi
  done
  ;;
install)
  ((${#HOSTS[@]} == 1)) || die "install takes exactly one host"
  h="${HOSTS[0]}"
  [[ "$(realization "$h")" == machine ]] || die "install requires a machine realization"
  machine_install "$h"
  ((DRY_RUN)) && exit 0
  ssh_for "$h" machine
  install_verify_addr "$h"
  echo "$h: waiting for boot -- type the LUKS passphrase at its console"
  wait_ssh_unlock "$h" || die "$h: installed but unreachable within ${TIMEOUT}s"
  smoke "$h" || die "$h: booted but not healthy"
  install_verify_seed "$h" || die "$h: seeded checkouts missing or unusable"
  install_verify_credentials "$h" || die "$h: boot-credential invariant failed"
  echo "$h: reinstall verified"
  ;;
test)
  for h in "${HOSTS[@]}"; do
    run_test "$h"
  done
  echo
  printf '%-24s %-8s %s\n' HOST REALIZED RESULT
  for line in "${RESULTS[@]}"; do
    # shellcheck disable=SC2086 # intentional word split into three columns
    printf '%-24s %-8s %s\n' $line
  done
  exit "$FAILED"
  ;;
esac
